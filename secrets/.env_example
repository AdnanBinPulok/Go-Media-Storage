# Local development environment values
# Do not commit real secrets.

APP_HOST=0.0.0.0
APP_PORT=9023
LOG_LEVEL=info
BASE_URL="https://vault.example.com"

POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres_user"
POSTGRES_PASSWORD="change_me_in_production"
POSTGRES_DB="media_storage_db"
POSTGRES_SSL_MODE="disable"

DATABASE_DSN="postgres://postgres_user:change_me_in_production@localhost:5432/media_storage_db?sslmode=disable"
DATABASE_MAX_OPEN_CONNS=25
DATABASE_MAX_IDLE_CONNS=25

FILE_STORAGE_LOCAL_BASE_PATH="./storage"
FILE_STORAGE_LIMIT="100GB"

BROWSER_CACHE_TIME_SECONDS=30
PROXY_CACHE_TIME_SECONDS=60
